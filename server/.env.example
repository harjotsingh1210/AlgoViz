# Environment Variables for AlgoViz Backend

# === MongoDB Atlas ===
# Get this from: MongoDB Atlas > Clusters > Connect > Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/algoviz?retryWrites=true&w=majority

# === JWT Secret ===
# Use a long random string (minimum 32 characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# === Server ===
PORT=5000
NODE_ENV=development

# === Frontend URL (for CORS) ===
# In production, change to your Vercel URL
CLIENT_URL=http://localhost:8080
